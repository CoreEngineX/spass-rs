/target

# OS
.DS_Store
.DS_Store?
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Sensitive / generated outputs — never commit decrypted data or real exports
decrypted_output.txt
passwords.csv
*.spass

# Whitelist the small synthetic test fixtures generated by
# `cargo test generate_website_fixtures{,_v31,_besteffort}` (a few KB each).
!gen-test/v30/*.spass
!gen-test/v31/*.spass
!gen-test/besteffort/*.spass

# But keep the 1M-entry stress fixtures ignored (~100-200 MB each).
gen-test/*/test05-1m.spass

# Backup / stale source trees (root-level only)
/src/
/src_backup/
/README.md.backup

# Developer-local scripts (publish helpers, scratch tools). Whole
# scripts/ folder ignored except for ci-check.sh which is the
# committed pre-push gate referenced by CI.
/scripts/*
!/scripts/ci-check.sh
